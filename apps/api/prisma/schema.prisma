datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      String   @default("PATIENT") // Alterado para String para melhor compatibilidade SQLite
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctorProfile  DoctorProfile?
  patientProfile PatientProfile?

  patientAppointments Appointment[] @relation("PatientAppointments")
  doctorAppointments  Appointment[] @relation("DoctorAppointments")

  patientRecords MedicalRecord[] @relation("PatientRecords")
  doctorRecords  MedicalRecord[] @relation("DoctorRecords")

  patientPrescriptions Prescription[] @relation("PatientPrescriptions")
  doctorPrescriptions  Prescription[] @relation("DoctorPrescriptions")
}

model ConsultationModel {
  id              Int           @id @default(autoincrement())
  doctorProfileId Int
  doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id])
  name            String
  durationMinutes Int
  price           Float
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model DoctorProfile {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  user         User     @relation(fields: [userId], references: [id])
  specialty    String
  crm          String   @unique
  bio          String?
  availability String?  // SQLite usa String para armazenar JSON serializado

  consultationModels ConsultationModel[]
}

model PatientProfile {
  id               Int      @id @default(autoincrement())
  userId           Int      @unique
  user             User     @relation(fields: [userId], references: [id])
  cpf              String?
  phone            String?
  medicalHistory   String?
  /// Cliente Asaas vinculado ao salvar CPF/celular (acelera checkout PIX/cartão).
  asaasCustomerId  String?

  @@index([asaasCustomerId])
}

model Appointment {
  id                  Int      @id @default(autoincrement())
  patientId           Int
  patient             User     @relation("PatientAppointments", fields: [patientId], references: [id])
  doctorId            Int
  doctor              User     @relation("DoctorAppointments", fields: [doctorId], references: [id])
  date                DateTime
  status              String   @default("CONFIRMED") // CONFIRMED ao persistir; COMPLETED, CANCELLED em fluxos futuros
  paymentId           String?  @unique
  cancelledAt         DateTime?
  cancellationReason  String?
  cancelledBy         String?  // 'PATIENT' | 'DOCTOR'
  consultationModelId Int?
  durationMinutes     Int      @default(60)
  price               Float    @default(150.0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  medicalRecord MedicalRecord?
  prescriptions Prescription[]

  // Unicidade de slot é um índice UNIQUE PARCIAL (WHERE status <> 'CANCELLED'),
  // criado à mão na migration add_appointment_cancellation_partial_unique —
  // Prisma não expressa índices parciais. NÃO recriar @@unique([doctorId,date]) aqui
  // (bloquearia re-book de slot cancelado). Preservar o índice parcial em migrations futuras.
  @@index([doctorId, date])
  @@index([patientId, date])
  @@index([date])
}

model MedicalRecord {
  id            Int          @id @default(autoincrement())
  patientId     Int
  patient       User         @relation("PatientRecords", fields: [patientId], references: [id])
  doctorId      Int
  doctor        User         @relation("DoctorRecords", fields: [doctorId], references: [id])
  appointmentId Int?         @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  content   String // Armazenará o conteúdo do prontuário (HTML do Tiptap, encriptado via AES-256-GCM em repouso)
  status    String   @default("DRAFT") // DRAFT ou SIGNED
  type      String   @default("EVOLUTION") // EVOLUTION, ANAMNESIS, etc.
  template  String   @default("FREE") // FREE (texto livre) ou SOAP (Subjetivo/Objetivo/Avaliação/Plano)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Novos campos de assinatura digital para validade e integridade
  signature     String?   // Assinatura criptográfica (ex: hash assinado)
  signatureDate DateTime? // Data/hora exata da assinatura
  signedHash    String?   // Hash SHA-256 do conteúdo no momento da assinatura
  signerUserId  Int?      // ID do médico que assinou o documento

  audits MedicalRecordAudit[]

  @@index([patientId, createdAt])
  @@index([doctorId, patientId])
}

model MedicalRecordAudit {
  id              Int           @id @default(autoincrement())
  medicalRecordId Int
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  content         String
  changedByUserId Int
  changedAt       DateTime      @default(now())
  reason          String?

  @@index([medicalRecordId])
}

model Prescription {
  id            Int          @id @default(autoincrement())
  patientId     Int
  patient       User         @relation("PatientPrescriptions", fields: [patientId], references: [id])
  doctorId      Int
  doctor        User         @relation("DoctorPrescriptions", fields: [doctorId], references: [id])
  appointmentId Int?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  medications   String       // JSON string contendo array de medicamentos
  observations  String?      // Observacoes gerais
  
  status        String       @default("DRAFT") // DRAFT, SIGNED
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Assinatura digital (BirdID)
  signature     String?
  signatureDate DateTime?
  signedHash    String?

  @@index([patientId, createdAt])
  @@index([doctorId, patientId])
}

/// Escalas psicométricas aplicadas aos pacientes (PHQ-9, GAD-7, AUDIT, MOCA).
/// Médico cria → gera access_token → paciente responde via URL pública →
/// score calculado e severidade definida automaticamente.
model ClinicalScale {
  id          Int      @id @default(autoincrement())
  patientId   Int
  doctorId    Int
  type        String   // PHQ9 | GAD7 | AUDIT | MOCA
  status      String   @default("PENDING") // PENDING | COMPLETED | EXPIRED
  accessToken String   @unique // UUID para URL pública
  answers     String?  // JSON array de respostas (índice → score)
  totalScore  Int?     // score final calculado
  severity    String?  // mínima | leve | moderada | moderadamente grave | grave
  notes       String?  // observações do médico ao criar
  createdAt   DateTime @default(now())
  completedAt DateTime?
  expiresAt   DateTime // 14 dias por padrão

  @@index([patientId, createdAt])
  @@index([doctorId, patientId])
  @@index([accessToken])
}

/// Pagamento Asaas iniciado antes da consulta existir no banco (checkout único).
model PendingCheckout {
  id                  Int      @id @default(autoincrement())
  patientId           Int
  doctorId            Int
  date                DateTime
  asaasPaymentId      String   @unique
  consultationModelId Int?
  durationMinutes     Int      @default(60)
  price               Float    @default(150.0)
  createdAt           DateTime @default(now())

  @@index([doctorId, date])
  @@index([patientId])
}

model EmailOutbox {
  id                String   @id @default(uuid())
  to                String
  subject           String
  tag               String
  payload           String?  // JSON com contexto (userName, url) p/ re-render no worker
  status            String   @default("PENDING") // PENDING | SENT | FAILED
  providerMessageId String?
  errorMessage      String?
  attempts          Int      @default(0)
  createdAt         DateTime @default(now())
  sentAt            DateTime?
  failedAt          DateTime?

  @@index([status, createdAt])
  @@index([tag, createdAt])
  @@map("email_outbox")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}
