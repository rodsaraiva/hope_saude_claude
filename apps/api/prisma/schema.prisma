datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      String   @default("PATIENT") // Alterado para String para melhor compatibilidade SQLite
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctorProfile  DoctorProfile?
  patientProfile PatientProfile?
}

model DoctorProfile {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  user         User     @relation(fields: [userId], references: [id])
  specialty    String
  crm          String   @unique
  bio          String?
  availability String?  // SQLite usa String para armazenar JSON serializado
}

model PatientProfile {
  id               Int      @id @default(autoincrement())
  userId           Int      @unique
  user             User     @relation(fields: [userId], references: [id])
  cpf              String?
  phone            String?
  medicalHistory   String?
  /// Cliente Asaas vinculado ao salvar CPF/celular (acelera checkout PIX/cartão).
  asaasCustomerId  String?
}

model Appointment {
  id        Int      @id @default(autoincrement())
  patientId Int
  doctorId  Int
  date      DateTime
  status    String   @default("PENDING") // PENDING, CONFIRMED, COMPLETED, CANCELLED
  paymentId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Pagamento Asaas iniciado antes da consulta existir no banco (checkout único).
model PendingCheckout {
  id             Int      @id @default(autoincrement())
  patientId      Int
  doctorId       Int
  date           DateTime
  asaasPaymentId String   @unique
  createdAt      DateTime @default(now())
}
