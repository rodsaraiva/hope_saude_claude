# Copie para .env na pasta apps/api (não commite o arquivo .env)
DATABASE_URL="file:./dev.db"

# JWT — GERE UM SECRET FORTE: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=""
JWT_EXPIRES_IN="60m"

# CORS — lista de origins permitidas separadas por vírgula
CORS_ORIGINS="http://localhost:3001"

# Rate limiting para /auth/*
AUTH_THROTTLE_TTL="60"
AUTH_THROTTLE_LIMIT="10"

LIVEKIT_API_KEY="MOCK_API_KEY"
LIVEKIT_API_SECRET="MOCK_API_SECRET"
LIVEKIT_WS_URL="ws://localhost:7880"

ASAAS_API_URL="https://api-sandbox.asaas.com/v3"
ASAAS_API_KEY=""
